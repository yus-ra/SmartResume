# ============================================================
# SmartResume API — environment template
#
# Copy to `server/.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored. NEVER commit real credentials.
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000

# Origin of the React client, used for CORS and cookie scoping.
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# Leave empty to boot without a database. The server will start, log a
# warning, and answer database-backed routes with 503 until this is set.
MONGODB_URI=

# ---- Auth ----
# Secret used to sign session JWTs.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left empty the server generates a random secret at boot and warns,
# which invalidates existing sessions on every restart (dev-only safety).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Password-recovery email ----
# Required to send reset links. Use values from your SMTP provider and a
# verified sender address. SMTP_SECURE should match the provider's TLS mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- AI explanation (OpenRouter) ----
# Optional. Create a key at https://openrouter.ai/keys and keep it server-side.
# Available model page: https://openrouter.ai/stepfun/step-3.5-flash
# The selected text-generation model currently costs $0.10/M input and
# $0.30/M output tokens; confirm current pricing and availability before use.
# Without both values, AI explanations are unavailable; deterministic matching
# remains available.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stepfun/step-3.5-flash
